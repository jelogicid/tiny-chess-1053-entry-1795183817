import os,json,urllib.request as U
D={'P':(-10,-20,-11,-9),'N':(-19,-8,12,21,19,8,-12,-21),'B':(-9,11,9,-11),'R':(-10,1,10,-1)}
D['Q']=D['K']=D['B']+D['R']
X=dict(P=100,N=280,B=320,R=479,Q=929,K=60000)
L=60000
G=0
C=[(0,10,60)]*2+[(0,10,120),(0,10,60),(0,0,120),(1,0,90),(1,10,70)]+[(0,0,60)]*8
Y=set()
class T(Exception):0
def mk(E):
 W={}
 for p in X:
  t=[0]*120
  for i in range(21,99):
   r=i//10-2
   f=i%10-1
   g=min(f,7-f)
   d=g+min(r,7-r)
   if 0<=f<8:t[i]=X[p]+{'P':(6-r)**2*(3+2*E)+(r>3)*g*4+E*(r>3)*25,'N':d*14-(r>6)*12,'B':d*7-(r>6)*12,'R':(r==1)*20,'Q':d*3,'K':d*20 if E else(r-4)*10+abs(2*f-7)*2}[p]
  W[p]=t
 return W
def R(s):
 return s[0][::-1].swapcase(),-s[1],s[3],s[2],119-s[4]if s[4]else 0
def Pt(t,k,x):
 return t[:k]+x+t[k+1:]
def gen(s):
 b,_,w,_,e=s
 for i,p in enumerate(b):
  if p.isupper():
   for d in D[p]:
    j=i
    while 1:
     j+=d
     q=b[j]
     if q.isspace()or q.isupper():break
     if p=='P':
      if d in(-10,-20)and q!='.'or d==-20 and(i<81 or b[i-10]!='.'):break
      if d in(-11,-9)and q=='.'and j!=e:break
     yield i,j
     if p in'PNK'or q.islower():break
     if i==91 and b[j+1]=='K'and w[0]:yield j+1,j-1
     if i==98 and b[j-1]=='K'and w[1]:yield j-1,j+1
from functools import cache
@cache
def pressure(k,p):
 def score(j):
  x=abs(j%10-k%10)
  y=abs(j//10-k//10)
  return max(0,5-max(x,y))*{'Q':9,'B':4,'R':4,'N':6}[p]+5*(p in 'BQ' and x==y or p in 'RQ' and not x*y)
 return [score(j) for j in range(120)]
def V(s,m):
 b=s[0]
 i,j=m
 p=b[i]
 q=b[j]
 r=W[p][j]-W[p][i]
 if q.islower():r+=W[q.upper()][119-j]
 if p in 'QBNR':
  t=pressure(b.find('k'),p)
  r+=t[j]-t[i]
 if p=='K'and abs(i-j)==2:r+=C[G][1]+W['R'][(i+j)//2]-W['R'][91 if j<i else 98]
 if p=='K'and F:
  k=b.find('k')
  r+=(abs(i//10-k//10)+abs(i%10-k%10)-abs(j//10-k//10)-abs(j%10-k%10))*15
 if p=='P':
  if j<30:r+=W['Q'][j]-W['P'][j]
  if j==s[4]:r+=W['P'][109-j]
 return r
def mv(s,m):
 b,sc,w,c,e=s
 i,j=m
 p=b[i]
 sc+=V(s,m)
 b=Pt(Pt(b,j,p),i,'.')
 if i==91:w=(0,w[1])
 if i==98:w=(w[0],0)
 if j==21:c=(c[0],0)
 if j==28:c=(0,c[1])
 e=0
 if p=='K':
  w=(0,0)
  if abs(j-i)==2:b=Pt(Pt(b,91 if j<i else 98,'.'),(i+j)//2,'R')
 if p=='P':
  if j<30:b=Pt(b,j,'Q')
  if i-j==20:e=i-10
  if j==s[4]:b=Pt(b,j+10,'.')
 return R((b,sc,w,c,e))
def S(s,a,b,d):
 global n
 n+=1
 if n>L:raise T
 if s[1]<-4e4:return s[1]-max(d,0)
 o=a
 h=0
 q=d<1
 z=Z.get(s)
 if z and not q:
  if z[0]>=d:
   f,v=z[1:3]
   if f==0 or f==1 and v>=b or f==2 and v<=a:return v
  h=z[3]
 if C[G][0]and d>2 and not F and b<4e4 and -S(R(s),-b,1-b,d-3)>=b:return b
 best=-9e4
 m0=0
 if q:
  best=s[1]
  if best>=b:return best
  a=max(a,best)
 ms=sorted(gen(s),key=lambda m:-V(s,m))
 if h:ms.sort(key=lambda m:m!=h)
 k=1
 for m in ms:
  if q and V(s,m)<60:break
  c=mv(s,m)
  if k:
   v=-S(c,-b,-a,d-1)
  else:
   v=-S(c,-a-1,-a,d-1)
   if a<v<b:v=-S(c,-b,-a,d-1)
  k=0
  if v>best:
   best=v
   m0=m
  a=max(a,best)
  if a>=b:break
 if best<-4e4 and not q:
  t=R(s)
  if not any(V(t,m)>4e4 for m in gen(t)):best=0
 if not q:Z[s]=d,2 if best<=o else 1 if best>=b else 0,best,m0
 return best
def play(f,lg):
 global n,Z,W,F
 a=f.split()
 bl=a[1]=='b'
 c=a[2]
 b='         \n'*2+''.join(' '+''.join('.'*int(h)if h.isdigit()else h for h in o)+'\n'for o in a[0].split('/'))+'         \n'*2
 if bl:b=b[::-1].swapcase()
 r=lambda k:119-k if bl else k
 g=lambda x:r(10*(10-int(x[1]))+ord(x[0])-96)
 w=('Q'in c,'K'in c)
 x=('k'in c,'q'in c)
 if bl:w,x=x,w
 F=sum(X[h.upper()]for h in a[0]if h.upper()in'NBRQ')<3000
 W=mk(F)
 s=b,sum(W[p][i]if p.isupper()else-W[p.upper()][119-i]for i,p in enumerate(b)if p.isalpha()),w,x,g(a[3])if a[3]!='-'else 0
 M={}
 for m in lg:
  if m[4:]in('','q'):M[g(m[:2]),g(m[2:4])]=m
 Z={}
 n=L-C[G][2]*1000
 ms=sorted(M,key=lambda m:-V(s,m))
 best=ms[0]
 try:
  for d in range(1,9):
   al=-90001
   bm=ms[0]
   for m in ms:
    c=mv(s,m)
    v=-S(c,-9e4,-al,d-1)
    if v>0 and c[0]in Y:v-=200
    if v>al:
     al=v
     bm=m
   best=bm
   ms.sort(key=lambda m:m!=bm)
   if al>4e4:break
 except T:pass
 Y.add(mv(s,best)[0])
 return M[best]
ABC='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
def square(c):
 n=ABC.index(c)
 return 'abcdefgh'[n%8]+str(1+n//8)
BOOK='LbzjKayqBS+tMU0sDK5zKDskGXtcDn7gXmcSn187ms McyiGVzrLbibVb+tFhtzCm3vDnwohz5zBSzkSjkaEC7gJZgQCBQJ Mc0kGV5qFa9iKS+tVftcflcNDVNHl280V10r2l Mc0kGV5qFh+tEGtcFEcmVkmsBSqbhY3nOe2uIQwoen7fnufPGFPH LbzjKayqGV+tBSjaMcxhIYhZFaZSa181OeSJVm1uDV*JAqVl6lcluvm1 Mc0kGVzrLb+tBS5zCU2uFa3vEGteULyqPXvnXeneVmeWm1/HGH7fHGfP'.split()
LINES={}
def book_lines(row):
 if row not in LINES:
  L=[];k=0
  while k<len(row):
   if row[k]=='*':L.append(square(row[k+1])+square(row[k+2])+row[k+3]);k+=4
   else:L.append(square(row[k])+square(row[k+1]));k+=2
  LINES[row]=L
 return LINES[row]
def choose(g):
 moves=g['moves']
 legal=g['legal_moves']
 i=len(moves)
 for row in BOOK:
  if i*2>=len(row):continue
  line=book_lines(row)
  if line[:i]==moves and line[i] in legal:return line[i]
 for row in BOOK:
  if i*2>=len(row):continue
  line=book_lines(row)
  if len(line)>i and all(line[j][:4]==moves[j][:4] for j in range(i)):
   if line[i] in legal:return line[i]
   for m in legal:
    if m[:4]==line[i][:4]:return m
 try:return play(g['fen'],legal)
 except:return legal[0]
if __name__=='__main__':
 u=next(v for k,v in os.environ.items() if'ENV_URL'in k).rstrip('/')
 def H(p,d):
  return json.load(U.urlopen(U.Request(u+p,json.dumps(d).encode(),{'Content-Type':'application/json'})))
 while 1:
  g=H('/game',{})
  if g.get('status')=='done':break
  G=g['game']
  Y.clear()
  while g['status']=='your_move':g=H('/move',{'game':G,'move':choose(g)})
